; Engine configuration file.
; Godot 4.7 prototype of Novice to Hero (real-time roguelike ARPG). See docs/design/pivot-godot-arpg-v1.md.

config_version=5

[application]

config/name="Novice to Hero (Godot slice)"
run/main_scene="res://scenes/arena3d.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameData="*res://autoload/game_data.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
